# Copia este ficheiro para .env e ajusta. NUNCA faças commit do .env.
# Gerar uma SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Combina com o docker-compose.yml (so para desenvolvimento local)
DATABASE_URL=postgres://chess:chess@localhost:5432/chess

# Usado a partir da Fase 1 (tarefas em segundo plano)
# REDIS_URL=redis://localhost:6379/0

# Opcional: token pessoal da Lichess (Preferences > API access tokens). Sem ele, a Lichess
# so devolve uma copia em cache do historico de ratings, ou nenhum.
# LICHESS_API_TOKEN=
